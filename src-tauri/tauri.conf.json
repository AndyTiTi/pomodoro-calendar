{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面番茄日历",
  "version": "0.1.0",
  "identifier": "com.yunzhanlab.pomodoro-calendar",
  "build": {
    "beforeDevCommand": "vite --port 27890",
    "devUrl": "http://localhost:27890",
    "beforeBuildCommand": "vite build --config tauri.vite.config.ts",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌面番茄日历",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
