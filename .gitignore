# Dependencies
node_modules/
*/node_modules/

# Web production builds (Vite / 妙搭托管产物)
dist/
*/dist/

# Tauri build artifacts (Rust target dir + generated schemas + renderer bundle).
# src-tauri source, config, capabilities and icons ARE tracked.
src-tauri/target/
src-tauri/gen/schemas/
dist-tauri/

# Convenience copy of the Tauri installer (scripts/copy-release.mjs); distributed
# via GitHub Releases, not committed.
release/

# Build assets: ignore everything except the app icon needed for packaging
build/*
!build/icon.png

# Generated icon source scratch
vibe_images/

# Environment files
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov

